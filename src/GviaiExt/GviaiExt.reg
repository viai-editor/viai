REGEDIT4

[HKEY_CLASSES_ROOT\CLSID\{F191A2A2-D786-484E-A3F4-8A75FDD9AC00}]
   @="ViAI Shell Extension"
[HKEY_CLASSES_ROOT\CLSID\{F191A2A2-D786-484E-A3F4-8A75FDD9AC00}\InProcServer32]
   @="gviaiext.dll"
   "ThreadingModel"="Apartment"

[HKEY_CLASSES_ROOT\*\shellex\ContextMenuHandlers\gviai]
   @="{F191A2A2-D786-484E-A3F4-8A75FDD9AC00}"

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Shell Extensions\Approved]
   "{F191A2A2-D786-484E-A3F4-8A75FDD9AC00}"="ViAI Shell Extension"

[HKEY_LOCAL_MACHINE\Software\ViAI\Gviai]
   "path"="gviai.exe"

[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Uninstall\ViAI 1.0]
   "DisplayName"="ViAI 1.0: Edit with ViAI popup menu entry"
   "UninstallString"="uninstall.exe"
